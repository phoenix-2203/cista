{
  "name": "@cista/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "CistaVerifier: checks a Cista pay run's ML-DSA-87 signature and payslip fields on chain.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "tsx scripts/build.ts && vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:testnet": "node --env-file-if-exists=.env.seed --import tsx scripts/deploy.ts",
    "qday:drill": "node --env-file-if-exists=.env.seed --import tsx scripts/qday-drill.ts"
  },
  "devDependencies": {
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@phoenix-2203/cista": "workspace:*",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qoresign": "^0.2.0",
    "@qorechain/sdk": "^0.14.0",
    "@types/node": "^26.6.6",
    "solc": "0.8.28",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.53.1",
    "vitest": "^5.1.1"
  }
}
